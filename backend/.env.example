# Campus Connect Backend Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=production

# Cloudinary Image Storage (Required in production)
# Option A: Single connection URL
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option B: Individual credentials (alternative)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
